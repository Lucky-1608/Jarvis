# ===========================================================================
# Jarvis OS — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Primary AI Provider — OpenCode
# ---------------------------------------------------------------------------
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free


# ---------------------------------------------------------------------------
# Ollama (local / offline)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Ollama Cloud (remote)
# ---------------------------------------------------------------------------
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=minimax-m3:cloud
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key_here


# ---------------------------------------------------------------------------
# Nvidia NIM (high-performance fallback / vision)
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ---------------------------------------------------------------------------
# Grok / xAI (cloud fallback)
# ---------------------------------------------------------------------------
GROK_API_KEY=your_grok_api_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ---------------------------------------------------------------------------
# Google Gemini (cloud fallback)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
# ---------------------------------------------------------------------------
# AI Router defaults
# ---------------------------------------------------------------------------
# Which provider to use as primary: opencode | openrouter | ollama | ollama_cloud | nvidia
AI_PRIMARY_PROVIDER=ollama_cloud
AI_FALLBACK_PROVIDERS=opencode,nvidia,grok,gemini,ollama
AI_TOOL_SELECTOR_ENABLED=false

# ---------------------------------------------------------------------------
# Memory — ChromaDB
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DEBUG=true

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JARVIS_SECRET_KEY=change-this-to-a-random-secret
JARVIS_REQUIRE_AUTH=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# WhatsApp Bridge
# ---------------------------------------------------------------------------
WHATSAPP_OWNER_NUMBER=YOUR_NUMBER_HERE

# ---------------------------------------------------------------------------
# Telegram Bridge
# ---------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Get your numeric user ID from @userinfobot on Telegram
TELEGRAM_OWNER_ID=YOUR_OWNER_ID_HERE

TRACEROOT_API_KEY=your_traceroot_api_key_here

# ---------------------------------------------------------------------------
# OAuth Integrations
# ---------------------------------------------------------------------------
# Google Workspace
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Notion
NOTION_CLIENT_ID=your_notion_client_id_here
NOTION_CLIENT_SECRET=your_notion_client_secret_here

# GitHub
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
# ===========================================================================
# Advanced Plugin Environment Variables
# ===========================================================================

# Database & Infrastructure
DATABASE_URL=postgresql://user:pass@localhost:5432/db

# Communication & Collaboration
GITHUB_TOKEN=ghp_your_github_token


# Media, AI & Content
OPENAI_API_KEY=sk-your-openai-key
NOTION_API_KEY=secret_your_notion_key
HF_TOKEN=your_huggingface_token_here


# IoT & Web3

# speech api for stt
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia

# ---------------------------------------------------------------------------
# ElevenLabs
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY_1=your_elevenlabs_api_key_1_here
ELEVENLABS_API_KEY_2=your_elevenlabs_api_key_2_here
ELEVENLABS_API_KEY_3=your_elevenlabs_api_key_3_here
ELEVENLABS_API_KEY_4=your_elevenlabs_api_key_4_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# ---------------------------------------------------------------------------
# Embeddings (Jina API)
# ---------------------------------------------------------------------------
JINA_API_KEY=your_jina_api_key_here

JARVIS_DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/postgres
