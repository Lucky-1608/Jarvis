# ===========================================================================
# Jarvis OS — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Primary AI Provider — OpenCode
# ---------------------------------------------------------------------------
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/v1
OPENCODE_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# OpenRouter (fallback / advanced reasoning)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ---------------------------------------------------------------------------
# Ollama (local / offline)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Nvidia NIM (high-performance fallback / vision)
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# ---------------------------------------------------------------------------
# Grok / xAI (cloud fallback)
# ---------------------------------------------------------------------------
GROK_API_KEY=your_grok_api_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ---------------------------------------------------------------------------
# Google Gemini (cloud fallback)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# AI Router defaults
# ---------------------------------------------------------------------------
# Which provider to use as primary: opencode | openrouter | ollama | nvidia | grok | gemini
AI_PRIMARY_PROVIDER=opencode
AI_FALLBACK_PROVIDER=nvidia

# ---------------------------------------------------------------------------
# Memory — ChromaDB
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DEBUG=true

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JARVIS_SECRET_KEY=change-this-to-a-random-secret
JARVIS_REQUIRE_AUTH=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# WhatsApp Bridge
# ---------------------------------------------------------------------------
WHATSAPP_OWNER_NUMBER=YOUR_NUMBER_HERE

# ---------------------------------------------------------------------------
# Telegram Bridge
# ---------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Get your numeric user ID from @userinfobot on Telegram
TELEGRAM_OWNER_ID=YOUR_OWNER_ID_HERE

# ===========================================================================
# Advanced Plugin Environment Variables
# ===========================================================================

# Database & Infrastructure
DATABASE_URL=postgresql://user:pass@localhost:5432/db
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Communication & Collaboration
SLACK_BOT_TOKEN=xoxb-your-slack-token
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_USER=your_email@gmail.com

# ===========================================================================
# Advanced Plugin Environment Variables
# ===========================================================================

# Database & Infrastructure
DATABASE_URL=postgresql://user:pass@localhost:5432/db
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Communication & Collaboration
SLACK_BOT_TOKEN=xoxb-your-slack-token
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_USER=your_email@gmail.com
GITHUB_TOKEN=ghp_your_github_token

# Media, AI & Content
OPENAI_API_KEY=sk-your-openai-key
NOTION_API_KEY=secret_your_notion_key

# IoT & Web3
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=your_long_lived_access_token
ETH_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
